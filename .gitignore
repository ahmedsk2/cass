/vendor/
/node_modules/
/public/build/
/public/css/filament
/public/fonts/filament
/public/hot
/public/js/filament
/public/storage
/storage/*.key
/storage/app/private/
/storage/framework/
/storage/logs/
/bootstrap/cache/*.php
